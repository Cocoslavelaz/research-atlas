---
import '../styles/site.css'
import { route } from '../lib/atlas.mjs'
const { title = 'Research Atlas', section = 'library' } = Astro.props
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="以主題、研究重點與文獻關係整理論文的個人知識庫。" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">跳至內容</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={route()}><span class="brand-mark" aria-hidden="true">✳</span> Research Atlas</a>
        <nav aria-label="主選單">
          <a href={route()} aria-current={section === 'library' ? 'page' : undefined}>論文庫</a>
          <a href={route('graph/')} aria-current={section === 'graph' ? 'page' : undefined}>知識圖譜</a>
          <a href={route('guide/')} aria-current={section === 'guide' ? 'page' : undefined}>匯入論文</a>
        </nav>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell">
      <a class="brand" href={route()}><span class="brand-mark" aria-hidden="true">✳</span> Research Atlas</a>
      <span>論文參考文獻知識庫</span>
    </footer>
  </body>
</html>
